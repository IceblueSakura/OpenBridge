{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "observations": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "role": {
      "const": "mock_server_run"
    },
    "schema_version": {
      "const": "0.1"
    },
    "suite_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "role",
    "observations"
  ],
  "type": "object"
}
