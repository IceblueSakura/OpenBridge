{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "kinds": {
      "items": {
        "enum": [
          "one_byte",
          "line_boundaries",
          "utf8_split",
          "seeded"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "0.1"
    },
    "seeded_variants": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kinds",
    "seeded_variants"
  ],
  "type": "object"
}
