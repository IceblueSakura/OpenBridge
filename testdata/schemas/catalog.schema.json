{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_ids": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "corpus_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "default_generation_seed": {
      "minimum": 0,
      "type": "integer"
    },
    "required_core_features": {
      "items": {
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_generation_kinds": {
      "items": {
        "enum": [
          "one_byte",
          "line_boundaries",
          "utf8_split",
          "all_in_one",
          "event_pairs",
          "crlf",
          "seeded"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_semantic_features": {
      "items": {
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "0.1"
    },
    "semantic_case_ids": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "corpus_version",
    "title",
    "default_generation_seed",
    "required_core_features",
    "required_generation_kinds",
    "required_semantic_features",
    "case_ids",
    "semantic_case_ids"
  ],
  "type": "object"
}
