# Copy this file to .env. Existing process environment variables take precedence.
# Never commit the populated .env file.

# Required by the OpenBridge HTTP service for downstream Bearer authentication.
OPENBRIDGE_DOWNSTREAM_TOKEN=

# Upstream credentials. Configure the providers you intend to route to.
OPENAI_API_KEY=
LONGCAT_API_KEY=

# Optional. Defaults to config/bootstrap.toml.
OPENBRIDGE_BOOTSTRAP_CONFIG=config/bootstrap.toml

# Optional tracing filter. Defaults to info.
RUST_LOG=info
