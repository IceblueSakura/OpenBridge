# Copy this file to .env. Existing process environment variables take precedence.
# Never commit the populated .env file.

# Upstream credential pools. Each enabled provider requires a non-empty JSON string array.
OPENAI_API_KEYS=["replace-with-openai-key"]
LONGCAT_API_KEYS=["replace-with-longcat-key"]
OPENROUTER_API_KEYS=["replace-with-openrouter-key"]
DEEPSEEK_API_KEYS=["replace-with-deepseek-key"]
MIMO_API_KEYS=["replace-with-mimo-key"]

# Optional. Defaults to config/bootstrap.toml.
OPENBRIDGE_CONFIG=config/bootstrap.toml

# Optional tracing filter. Defaults to info.
RUST_LOG=info
