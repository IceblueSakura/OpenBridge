# Copy this file to .env. Existing process environment variables take precedence.

# mock is the safe default and makes no external request.
UPSTREAM_FIXTURE_MODE=mock
UPSTREAM_FIXTURE_LISTEN=127.0.0.1:4010

# Required only when UPSTREAM_FIXTURE_MODE=proxy. Include the protocol version
# path and a trailing slash, for example https://api.openai.com/v1/.
UPSTREAM_FIXTURE_API_BASE=
UPSTREAM_FIXTURE_API_KEY=

# Optional default for direct fixture probes that omit a model. An explicit
# model in the incoming Chat/Responses body always takes precedence.
UPSTREAM_FIXTURE_MODEL=

# Optional. Default: 120000.
UPSTREAM_FIXTURE_TIMEOUT_MS=120000
